# Local deploy credentials. Copy to `.env.deploy`, fill in, and source it:
#
#   cp .env.deploy.example .env.deploy
#   set -a && . ./.env.deploy && set +a
#   npm run build && npm run deploy:dry     # see what would change
#   npm run deploy
#
# `.env.deploy` is gitignored. Never commit real values — a password in git
# history is a password you have to rotate, not one you can delete.
#
# In CI these same five names come from the repository secrets, so the script
# behaves identically in both places.

SITEGROUND_FTP_HOST=
SITEGROUND_FTP_USER=
SITEGROUND_FTP_PASSWORD=
SITEGROUND_FTP_PORT=21
SITEGROUND_REMOTE_DIR=/public_html

# Must match the origin the site is served from, or every canonical link,
# hreflang, sitemap entry and llms.txt URL points at the wrong host.
SITE_URL=https://example.com

# Optional:
# FTP_PROTOCOL=ftps       # ftps (default) or ftp — ftp sends the password in clear
# FTP_TLS_INSECURE=1      # encrypted but unauthenticated; see scripts/deploy.mjs
# DEPLOY_SOURCEMAPS=1     # also upload *.map (~5 MB more)
# DEPLOY_FORCE=1          # ignore the remote manifest and re-upload everything
